<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_root"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CBD5B1"
    android:padding="16dp">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="2">

        <LinearLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="March 2025"
                android:textSize="14sp"
                android:textColor="#2E3C1A"
                android:drawableLeft="@android:drawable/ic_menu_month" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 March 2025 - 31 March 2025"
                android:textSize="12sp"
                android:textColor="#2E3C1A" />
        </LinearLayout>

        <ImageView
            android:id="@+id/profile_icon"
            android:layout_width="18dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/profile" />

    </LinearLayout>

    <!-- Summary Card -->
    <LinearLayout
        android:id="@+id/summaryCard"
        android:layout_below="@id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/card_background"
        android:layout_marginTop="16dp"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Summary"
                android:textStyle="bold"
                android:textColor="#2E3C1A"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance: R0.00"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:textColor="#2E3C1A" />
            <TextView
                android:id="@+id/textIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Income: R0.00"
                android:textSize="14sp"
                android:textColor="#2E3C1A" />
            <TextView
                android:id="@+id/textExpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expense: R0.00"
                android:textSize="14sp"
                android:textColor="#2E3C1A" />
        </LinearLayout>

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="end"
            android:src="@drawable/money"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <!-- Progress Section -->
    <LinearLayout
        android:id="@+id/progressSection"
        android:layout_below="@id/summaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical">

        <!-- Custom progress arc placeholder -->
        <TextView
            android:id="@+id/textBudgetPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="68%"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2E3C1A"
            android:layout_marginRight="24dp" />

        <ProgressBar
            android:id="@+id/budgetProgress"
            style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:indeterminate="false"
            android:max="100"
            android:progress="60"
            android:progressDrawable="@drawable/progress_bar"
            android:rotation="-90"
            android:layout_margin="16dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUDGET VS SPENT"
                android:textColor="#2E3C1A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R6800/ R10000 spent"
                android:textSize="14sp"
                android:textColor="#2E3C1A" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Spending Categories Card -->
    <LinearLayout
        android:id="@+id/topCategories"
        android:layout_below="@id/progressSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="16dp">

        <TextView
            android:id="@+id/textTopCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top Spending Categories:"
            android:textSize="16sp"
            android:textColor="#D19CA6"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥇 Entertainment"
            android:textColor="#2E3C1A"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥈 Rent"
            android:textColor="#2E3C1A"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥉 Gifting"
            android:textColor="#2E3C1A"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"/>

</RelativeLayout>